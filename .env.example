# ============================================
#  Nevocean Workspace — Production Environment
#  Copy to .env and fill in real values:
#    cp .env.example .env
#  NEVER commit .env — it is gitignored.
# ============================================

# === Database ===
POSTGRES_USER=nevodevs
POSTGRES_PASSWORD=CHANGE_THIS_strong_db_password
POSTGRES_DB=nevodevs

# === Security ===
# Generate a strong key:  openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_run_openssl_rand_hex_32

# === Environment ===
# "production" enables security startup-checks (refuses to boot with default secrets)
ENVIRONMENT=production

# === URLs ===
# Your public URL — used for CORS. Use https:// once SSL is set up.
FRONTEND_URL=http://your-server-ip

# === Media (avatars) ===
# Directory inside the backend container; docker-compose mounts the `media`
# volume here so uploads survive rebuilds. Change only if you know why.
MEDIA_ROOT=/app/media
